#if canImport(UIKit)
import SwiftUI
import ADFPreparation
@testable import ADFRendering

/// Legacy variant of `Tests/ADFRenderingTests/Perf/PerfProbeCompat.swift`,
/// overlaid by `Scripts/perf-probe.sh` onto refs without
/// `TextKit2Scope.inheritsRenderer` (TK2 stack PR 1, 86abd56): there
/// `DocumentRow` passes the renderer to top-level `.richText` only, and no
/// list width exists. Same names and shapes as the current variant.
enum PerfProbeCompat {
    static let routing = "legacy-richText-only"

    static func rowRenderer(for kind: RenderBlock.Kind, _ renderer: ADFTextRenderer) -> ADFTextRenderer {
        if case .richText = kind { return renderer }
        return .swiftUI
    }

    struct ListWidth: ViewModifier {
        let width: CGFloat

        func body(content: Content) -> some View {
            content
        }
    }
}
#endif
